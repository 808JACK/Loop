# Application
APP_NAME=AI SDLC Automation
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_sdlc
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Queue
QUEUE_TYPE=sqs
SQS_REGION=us-east-1
SQS_QUEUE_URL=your_sqs_queue_url
SQS_ACCESS_KEY_ID=your_sqs_access_key
SQS_SECRET_ACCESS_KEY=your_sqs_secret_key

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:32b

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key

# Groq
GROQ_API_KEY=your_groq_api_key

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=your_ollama_api_key

# LLM Rate Limiting
LLM_REQUESTS_PER_MINUTE=8
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=15
LLM_QUEUE_TIMEOUT_SECONDS=900

# LangGraph Checkpointer
LANGGRAPH_POSTGRES_URL=postgresql://user:password@localhost:5432/ai_sdlc

# Jira/Confluence
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_jira_email
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ
JIRA_READY_LABEL=ai-ready
JIRA_REPO_URL_FIELDS=customfield_10100,customfield_10038
JIRA_REPO_NAME_FIELDS=customfield_10101,customfield_10039
JIRA_REVIEWER_FIELDS=customfield_10102,customfield_10040
GITHUB_REPO_OWNER=your_github_username

# Jira OAuth 2.0
JIRA_OAUTH_CLIENT_ID=your_jira_oauth_client_id
JIRA_OAUTH_CLIENT_SECRET=your_jira_oauth_client_secret
FRONTEND_URL=http://localhost:8080

# Git Platform
GIT_PLATFORM=github
GITHUB_TOKEN=your_github_token
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
GITLAB_TOKEN=your_gitlab_token
BITBUCKET_TOKEN=your_bitbucket_token
BITBUCKET_USERNAME=your_bitbucket_username
DEFAULT_REPO_URL=https://github.com/org/repo

# Worktree
WORKTREE_BASE_PATH=~/LOOP/worktrees
SANDBOX_TYPE=docker

# Execution Limits
EXECUTION_TIMEOUT_SECONDS=3600
MAX_TOKEN_BUDGET=100000
MAX_RETRY_COUNT=3

# Security
WEBHOOK_SECRET=your_webhook_secret
JWT_SECRET_KEY=change-this-in-production-use-a-long-random-string

# Observability
LOG_LEVEL=INFO
ENABLE_OTEL=false
OTEL_ENDPOINT=your_otel_endpoint
OTEL_SERVICE_NAME=ai-sdlc-automation

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=flux
